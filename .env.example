# SERV Reasoning API key, from console.openserv.ai
SERV_API_KEY=
# Model used for running checks and writing report summaries
SERV_MODEL=gpt-5.4-mini

# Reppo Evaluation API key, from eval.reppo.xyz
REPPO_API_KEY=
# Optional: base URL of the Reppo Evaluation API (defaults to https://eval.reppo.xyz/api/v1)
REPPO_API_URL=

# Lite Check (POST /api/lite, for Agent Parrot). A long random secret shared with Agent Parrot.
LITE_SECRET=
# Set to 0 to switch the Lite Check off.
LITE_ENABLED=
# Optional: SERV price per million tokens, for the lite cost estimate.
LITE_USD_PER_MTOK_IN=
LITE_USD_PER_MTOK_OUT=

# SERV Reasoning API key, from console.openserv.ai
SERV_API_KEY=
# Model used for running checks and writing report summaries
SERV_MODEL=gpt-5.4-mini

# Reppo Evaluation API key, from eval.reppo.xyz
REPPO_API_KEY=
# Optional: base URL of the Reppo Evaluation API (defaults to https://eval.reppo.xyz/api/v1)
REPPO_API_URL=
# Optional: Reppo settlement window in minutes (10, 15, 30, 60, 120, 360, 720, 1440). Default 10.
REPPO_SETTLEMENT_MINUTES=10
